# Резервные копии файлов, которые я делаю перед правкой.
# Нужны НА ДИСКЕ, чтобы было куда откатиться, но в репозитории им не место:
# это дословные копии прежних, в том числе непочиненных, версий кода.
*.bak
*.bak_*
*.bak[0-9]_*

# ── Временные файлы разбора. Держать ВНЕ репозитория ──────────────────────
# 🔴 08.08.2026 сюда по недосмотру уехал файл `_q2.mjs`: обычный `git add -A`
# подхватил вспомогательный скрипт, которым я ходила в базу. Секретов в нём не
# было — только путь к временному файлу, — но рядом лежал `db2.txt` со строками
# подключения к боевым базам, и попади он туда же, это была бы утечка.
# Проще запретить весь класс имён, чем каждый раз надеяться на внимательность.
_q*.mjs
_dec*.mjs
_rekey*.mjs
db.txt
db2.txt
secrets.txt
wallet*.txt
wallet*.json

# 🔴 ВРЕМЕННЫЕ ФАЙЛЫ С ДОСТУПАМИ — ЦЕЛЫМ КЛАССОМ, А НЕ ПОИМЁННО.
#
# 08.08.2026 сюда по недосмотру уехал `_q2.mjs`, и тогда в список внесли ровно
# те имена, что засветились: `_q*.mjs`, `db.txt`, `db2.txt`. Защита поимённая, а
# значит бесполезная: 09.08.2026 я работала с базами через `sub_url.txt`,
# `mem_url.txt` и `_dup.mjs` — ни одно из этих имён прежним правилам не
# подходило, и любой `git add -A` унёс бы строки подключения к боевым базам в
# отправку. В тот раз спасла только внимательность, а на неё полагаться нельзя.
#
# Правило по образцу закрывает и те имена, которых ещё никто не придумал.
_*.mjs
_*.cjs
*_url.txt
*_URL.txt
*db_url*
neon*.txt
env*.txt
envs*.txt
vc_env*.txt
# Эти четыре файла были под учётом ДО правила выше и остаются в хранилище:
# `_brain_upload.cjs` — рабочая заливка Мозга в Arweave, а не временный набросок.
# Три остальных — старые пробники, уже отправленные; правило про новые файлы, а
# не про переписывание истории.
!_brain_upload.cjs
!_turbotest.mjs
!_uk.mjs
!_x402test.mjs
# Резервные копии AIfa перед правкой — в репозиторий не идут.
*.before_*
